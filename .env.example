# Copy to .env (never commit .env)
PORT=4000
MONGO_URI=mongodb://localhost:27017/adaptive_dsa
JUDGE0_URL=http://localhost:2358

# Optional: AI "Explain my result" feedback. Leave ANTHROPIC_API_KEY empty to switch it off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_CALLS_PER_HOUR=10

# Accounts (defaults are fine for development)
# SESSION_DAYS=30
# COOKIE_SECURE=true          # set when the site is served over https (automatic when NODE_ENV=production)
# ALLOWED_ORIGINS=            # comma-separated extra sites allowed to call the API (normally empty)
# AUTH_SIGNUPS_PER_HOUR=10    # per IP address in production (200 in development)
# AUTH_LOGIN_ATTEMPTS=10      # wrong-password tries per email+IP per 15 minutes

# Google sign-in (leave empty to keep it switched off). Create these in the Google Cloud console, see README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback   # must match the console exactly
